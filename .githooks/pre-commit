#!/bin/sh
# ShopPilot privacy guard.
# Enable once per clone:  git config core.hooksPath .githooks
#
# Blocks a commit when it contains:
#   1. any file under data/ (except data/.gitkeep and data/README.md), reports/ or exports/
#   2. .env files, CSV / TSV / Excel files
#   3. personal email addresses or real marketplace shop URLs in added lines
#   4. any word listed in data/.private-keywords (your shop names, your name, etc. —
#      that file is git-ignored, so your private words never appear in the repo)

fail=0
kw_file="data/.private-keywords"
kw_tmp=""

if [ -f "$kw_file" ]; then
  kw_tmp=$(mktemp 2>/dev/null || echo ".git/shoppilot-kw.tmp")
  tr -d '\r' < "$kw_file" | grep -v '^[[:space:]]*#' | grep -v '^[[:space:]]*$' > "$kw_tmp"
  [ -s "$kw_tmp" ] || { rm -f "$kw_tmp"; kw_tmp=""; }
fi

generic='[A-Za-z0-9._%+-]+@(gmail|yahoo|hotmail|outlook|icloud|proton|protonmail|rediffmail)\.[a-z.]+|etsy\.com/(([a-z]{2}(-[a-z]{2})?)/)?shop/[A-Za-z0-9]|₹'

files=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$files" ] && exit 0

old_ifs=$IFS
IFS='
'
for f in $files; do
  # 1. private paths
  case "$f" in
    data/.gitkeep|data/README.md) ;;
    data/*|*/data/*|reports/*|*/reports/*|exports/*|*/exports/*)
      echo "BLOCKED  private path:       $f"; fail=1; continue ;;
  esac
  # 2. private file types
  case "$f" in
    .env|.env.*|*/.env|*/.env.*|*.csv|*.CSV|*.tsv|*.xlsx|*.XLSX|*.xls|*.xlsm)
      echo "BLOCKED  private file type:  $f"; fail=1; continue ;;
  esac
  # the hook itself holds the patterns, so its content is not scanned
  case "$f" in .githooks/*) continue ;; esac

  # file name against the private list
  if [ -n "$kw_tmp" ] && printf '%s\n' "$f" | grep -i -q -F -f "$kw_tmp"; then
    echo "BLOCKED  private keyword in file name: $f"; fail=1
  fi

  added=$(git diff --cached -U0 --diff-filter=ACMR -- "$f" | grep '^+' | grep -v '^+++')
  [ -z "$added" ] && continue

  # 3. generic personal-data patterns
  hit=$(printf '%s\n' "$added" | grep -i -E "$generic" | head -n 3)
  if [ -n "$hit" ]; then
    echo "BLOCKED  personal email / shop URL / currency figure in: $f"
    printf '%s\n' "$hit" | cut -c1-140 | sed 's/^/           /'
    fail=1
  fi

  # 4. private keyword list
  if [ -n "$kw_tmp" ]; then
    hit=$(printf '%s\n' "$added" | grep -i -F -f "$kw_tmp" | head -n 3)
    if [ -n "$hit" ]; then
      echo "BLOCKED  private keyword in: $f"
      printf '%s\n' "$hit" | cut -c1-140 | sed 's/^/           /'
      fail=1
    fi
  fi
done
IFS=$old_ifs

[ -n "$kw_tmp" ] && rm -f "$kw_tmp"

if [ "$fail" -ne 0 ]; then
  echo ""
  echo "Commit blocked by the ShopPilot privacy guard (.githooks/pre-commit)."
  echo "Remove the private content, or unstage the file:  git restore --staged <file>"
  exit 1
fi

if [ ! -f "$kw_file" ]; then
  echo "note: no data/.private-keywords file - add your shop names / personal names there (one per line) for full protection."
fi
exit 0
